#!/bin/sh

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
KNOWN_MEDIUM_PATHS="/run/live/medium /run/initramfs/live"
RELEASE="yirmibes-deb"
MEDIA_LIST="$CHROOT/etc/apt/sources.list.d/pardus-live-media.list"

# Support both dracut and initramfs configurations to avoid substitutions
# in live-build, see: #1089618
for path in $KNOWN_MEDIUM_PATHS; do
    if [ "$(mount | grep $path | cut -f3 -d" ")" = "$path" ]; then
        MEDIUM_PATH=$path
    fi
done

if [ "$1" = "-u" ]; then
    umount $CHROOT/$MEDIUM_PATH
    rm -f "$MEDIA_LIST"
    chroot $CHROOT apt-get update
    exit 0
fi

# Remove the Debian-specific base source list, but keep the Pardus
# sources that came from the live image.
rm -f "$CHROOT/etc/apt/sources.list.d/base.list"

# The live sources.list already points at the ISO; replace that entry
# with the temporary list created below.
SOURCES="$CHROOT/etc/apt/sources.list"
if [ -f "$SOURCES" ]; then
    sed -i '\#^deb \[trusted=yes\] file:#d' "$SOURCES"
fi

mkdir -p $CHROOT/$MEDIUM_PATH
mount --bind $MEDIUM_PATH $CHROOT/$MEDIUM_PATH
echo "deb [trusted=yes] file:$MEDIUM_PATH $RELEASE main contrib non-free non-free-firmware" > "$MEDIA_LIST"
chroot $CHROOT apt-get update
# Attempt safest way to remove cruft
rmdir $CHROOT/run/live/medium
rmdir $CHROOT/run/live

exit 0
