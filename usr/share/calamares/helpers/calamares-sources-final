#!/bin/sh
#
# Finalizes the APT sources copied from the Pardus live image.
#
# The Pardus installer keeps the sources that are already present in the
# live filesystem. Do the same here: do not generate a new sources.list,
# only drop the temporary live-medium entries.
#

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
SOURCES="$CHROOT/etc/apt/sources.list"

# Temporary source lists used while installing from the live medium.
rm -f "$CHROOT/etc/apt/sources.list.d/base.list"
rm -f "$CHROOT/etc/apt/sources.list.d/pardus-live-media.list"
rm -f "$CHROOT/etc/apt/sources.list.d/debian-live-media.list"

# The live image points at the mounted ISO; that path does not exist
# after the installed system reboots.
if [ -f "$SOURCES" ]; then
    sed -i '\#^deb \[trusted=yes\] file:#d' "$SOURCES"
fi

exit 0
